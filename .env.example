# =========================================================
# Zhizhi AI Agent (Python) — environment template
# Copy to .env and fill real values. Never commit .env.
# =========================================================

# --- LLM ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ARK_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# --- MySQL (W1) ---
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=zhizhi_ai_agent

# --- Redis (W1) ---
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Milvus (W2) ---
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=zhizhi_kb

# --- Feature flags ---
MCP_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=zhizhi-ai-agent
