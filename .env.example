# =========================================================
# Zhizhi AI Agent（Python）— 环境变量模板
# 复制为 .env 后填入真实值；切勿提交 .env。
# =========================================================

# ---------- LLM / 模型供应商 ----------
# 通义千问（DashScope，OpenAI 兼容接口）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 通义默认对话模型名（notebook / 演示用）
MODEL_NAME=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 火山方舟 / 豆包（ARK_API_KEY 与 DOUBAO_API_KEY 通常填同一个）
ARK_API_KEY=
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-1-turbo-260628

# 本地 Ollama（可选）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b

# Embedding：硅基流动 BAAI/bge-m3（免费额度见平台；维度 1024）
EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
#精排模型
CROSS_MODEL=BAAI/bge-reranker-v2-m3
#启动精排
RAG_RERANK_BACKEND=bge

# ---------- 鉴权（W1 D4 JWT） ----------
# 生产环境务必更换
JWT_SECRET=change-me-in-production
# Token 有效期（分钟），10080 = 7 天
JWT_EXPIRE_MINUTES=10080
# 生产务必 false，禁止公开注册刷 token；本地若要开放注册可改 true
REGISTER_ENABLED=false

# ---------- MySQL（会话 / 用户持久化） ----------
# true 时开放 /api/* 业务接口；请执行 bash scripts/init-mysql.sh（含 W2～W4 / agent_config）
# 本机 Docker 演练见 docker-compose.local.yml：宿主机映射 3307，不占用下面的 3306
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=zhizhi_ai_agent
# 本地 MySQL 8 常用：关闭 SSL；若驱动支持则允许公钥检索
MYSQL_SSL_DISABLED=true
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# ---------- Redis（停止信号等，W1 D5） ----------
# docker compose up -d redis  或本地 redis-server --requirepass root
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=root
# 逻辑库编号，默认 0
REDIS_DATABASE=0
# Agent 每步模拟耗时（秒），便于演示点停止
AGENT_STEP_DELAY_SECONDS=1.2

# ---------- Milvus（W2 RAG） ----------
# 远程云服务器示例：MILVUS_HOST=47.97.253.89
# 本地 compose：docker compose -f docker-compose.milvus.yml up -d 后用 127.0.0.1
MILVUS_ENABLED=false
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=zhizhi_kb
MILVUS_USER=
MILVUS_PASSWORD=

# Embedding / RAG 优化开关
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RAG_TOP_K=4
RAG_USE_REWRITE=true
RAG_USE_RERANK=true

# ---------- 工具 / 可观测性 ----------
# Tavily 网络搜索（Agent search_web）
TAVILY_API_KEY=
# Agent 产物目录
ARTIFACTS_DIR=data/artifacts

# ---------- W3 中间件 / HITL / MCP ----------
MEMORY_SUMMARIZE_TRIGGER=12
MEMORY_KEEP_RECENT=8
HITL_ENABLED=true
HITL_TIMEOUT_SECONDS=60
MCP_ENABLED=true
MCP_IMAGE_SEARCH_URL=http://127.0.0.1:8765/search
AGENT_TIMEOUT_SECONDS=180
LLM_TIMEOUT_SECONDS=60
AGENT_DAILY_QUOTA=50
# MinerU 文档解析（RAG notebook）
MINERU_API_TOKEN=
# 其它搜索 API（可选）
# SEARCH_API_KEY=
# LangSmith 链路追踪（默认可关：false 不上报、不耗额度）
# 打开条件：LANGSMITH_TRACING=true 且填写有效 LANGSMITH_API_KEY
# 云部署同样靠此开关；关掉即无出网、失败也不影响聊天
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zhizhi-ai-agent
# 兼容旧变量名（未设 LANGSMITH_PROJECT 时也可读）
LANGCHAIN_PROJECT=zhizhi-ai-agent
# 过长 Prompt 截断；true 则不上传输入/输出正文
LANGSMITH_MAX_INPUT_CHARS=4000
LANGSMITH_HIDE_IO=false
